#!/bin/sh
set -eu
if [ "${3:-/}" != / ]; then echo "Install on the running system volume." >&2; exit 1; fi
# Refuse unsafe existing destinations before Installer writes its root-owned payload.
for path in '/Library/PrivilegedHelperTools' '/Library/LaunchDaemons' '/Library/Application Support' '/Library/Application Support/OneLibraryCompanion' '/Library/Application Support/OneLibraryCompanion/Networking' '/Library/Application Support/OneLibraryCompanion/Networking/host.cdhash' '/Library/PrivilegedHelperTools/org.onelibrarycompanion.networking' '/Library/LaunchDaemons/org.onelibrarycompanion.networking.plist'; do
    if [ -L "$path" ]; then echo "Unsafe symbolic link: $path" >&2; exit 1; fi
    if [ -e "$path" ]; then
        owner=$(/usr/bin/stat -f '%u' "$path")
        mode=$(/usr/bin/stat -f '%Lp' "$path")
        if [ "$owner" != 0 ] || [ "$((0$mode & 0022))" != 0 ]; then
            echo "Unsafe ownership or write permissions: $path" >&2; exit 1
        fi
    fi
done
