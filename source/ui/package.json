{
  "name": "pioneer-companion-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "GPL-3.0-only"
}
